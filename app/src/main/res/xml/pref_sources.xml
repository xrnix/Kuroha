<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:title="@string/remote_sources">
	<ListPreference
		android:icon="@drawable/ic_sort_asc"
		android:key="sources_sort_order"
		android:title="@string/sort_order"
		app:useSimpleSummaryProvider="true" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_grid"
		android:key="sources_grid"
		android:title="@string/show_in_grid_view" />

	<PreferenceScreen
		android:fragment="org.koitharu.kotatsu.settings.sources.manage.SourcesManageFragment"
		android:icon="@drawable/ic_manga_source"
		android:key="remote_sources"
		android:persistent="false"
		android:title="@string/manage_sources"
		app:allowDividerAbove="true" />

	<Preference
		android:icon="@drawable/ic_list"
		android:key="sources_catalog"
		android:persistent="false"
		android:title="@string/sources_catalog" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_check"
		android:key="sources_enabled_all"
		android:summary="@string/enable_all_sources_summary"
		android:title="@string/enable_all_sources" />

	<SwitchPreferenceCompat
		android:defaultValue="true"
		android:icon="@drawable/ic_app_update"
		android:key="parsers_auto_update"
		android:summary="@string/sources_auto_update_summary"
		android:title="@string/sources_auto_update"
		app:allowDividerAbove="true" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_replace"
		android:key="mirror_switching"
		android:summary="@string/mirror_switching_summary"
		android:title="@string/mirror_switching" />

	<SwitchPreferenceCompat
		android:icon="@drawable/ic_open_external"
		android:key="handle_links"
		android:persistent="false"
		android:summary="@string/handle_links_summary"
		android:title="@string/handle_links" />

	<Preference
		android:icon="@drawable/ic_storefront"
		android:key="extension_stores"
		android:persistent="false"
		android:title="@string/extension_stores" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_shield"
		android:key="private_installer"
		android:summary="@string/private_extensions_summary"
		android:title="@string/private_extensions" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_auth_key_large"
		android:key="shizuku_installer"
		android:summary="@string/shizuku_summary"
		android:title="@string/shizuku_title" />

	<SwitchPreferenceCompat
		android:defaultValue="false"
		android:icon="@drawable/ic_updated"
		android:key="auto_update_extensions"
		android:summary="@string/ext_auto_update_summary"
		android:title="@string/ext_auto_update_title" />

</PreferenceScreen>
