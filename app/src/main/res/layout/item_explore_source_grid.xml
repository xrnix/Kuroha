<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	style="?attr/materialCardViewFilledStyle"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_margin="4dp"
	app:cardBackgroundColor="?attr/colorSurfaceContainer"
	app:cardCornerRadius="16dp"
	app:strokeWidth="0dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_horizontal"
		android:orientation="vertical"
		android:paddingHorizontal="8dp"
		android:paddingVertical="12dp">

		<org.koitharu.kotatsu.core.ui.image.FaviconView
			android:id="@+id/imageView_icon"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?colorSurfaceContainerHigh"
			android:labelFor="@id/textView_title"
			android:scaleType="fitCenter"
			app:iconStyle="@style/FaviconDrawable.Large"
			app:shapeAppearance="?shapeAppearanceCornerMedium"
			app:strokeWidth="0dp" />

		<TextView
			android:id="@+id/textView_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:drawablePadding="2dp"
			android:elegantTextHeight="false"
			android:ellipsize="end"
			android:gravity="center_horizontal"
			android:hyphenationFrequency="none"
			android:includeFontPadding="false"
			android:maxLines="2"
			android:minLines="1"
			android:textAlignment="center"
			android:textAppearance="?attr/textAppearanceLabelMedium"
			tools:drawableStart="@drawable/ic_pin_small"
			tools:text="@tools:sample/lorem[0]" />

	</LinearLayout>

</com.google.android.material.card.MaterialCardView>
